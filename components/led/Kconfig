menu "NoGPS LED"

    config NOGPS_LED_WS2812
        bool "Адресный светодиод WS2812 (как на ESP32-S3-Zero и ESP32-C3-Zero)"
        default n if IDF_TARGET_ESP32C3
        default y
        help
            Выключить, если светодиод обычный, на GPIO через резистор, как на ESP32-C3 SuperMini.

    config NOGPS_LED_GPIO
        int "GPIO светодиода"
        default 8 if IDF_TARGET_ESP32C3
        default 21
        help
            ESP32-S3-Zero — 21 (WS2812). ESP32-C3 SuperMini — 8 (обычный). ESP32-C3-Zero — 10 (WS2812).

    config NOGPS_LED_ACTIVE_LOW
        bool "Обычный светодиод горит при низком уровне"
        depends on !NOGPS_LED_WS2812
        default y if IDF_TARGET_ESP32C3
        default n
        help
            На ESP32-C3 SuperMini светодиод подключён к питанию и загорается, когда на GPIO8 ноль.

    config NOGPS_LED_BRIGHTNESS
        int "Яркость WS2812, 1–255"
        depends on NOGPS_LED_WS2812
        range 1 255
        default 24

endmenu
