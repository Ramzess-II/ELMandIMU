CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# У ESP32-S3-Zero нет USB-UART микросхемы, лог идёт через встроенный USB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Тик 1 мс, чтобы imu_task опрашивал FIFO ровно раз в 10 мс
CONFIG_FREERTOS_HZ=1000
# Приложение больше 1 МБ: раздел 1.5 МБ
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
